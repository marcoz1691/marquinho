# Copia este archivo como .env.local (local) o carga estas variables en Vercel → Settings → Environment Variables.
# Nunca subas las claves reales al repositorio.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=elige-una-frase-larga-y-secreta
WHATSAPP_API_VERSION=v23.0

# Avisos al personal (plantilla aprobada con un parámetro {{1}} en el cuerpo)
AVISOS_WHATSAPP=593996530276
AVISOS_PLANTILLA=aviso_personal
# Recordatorio de cita (plantilla aprobada con {{1}} nombre, {{2}} trámite, {{3}} hora)
RECORDATORIO_PLANTILLA=recordatorio_cita
# Avisos de cita cuando pasaron más de 24 h desde el último mensaje del cliente
# cita_confirmada: {{1}} nombre, {{2}} trámite, {{3}} día, {{4}} hora — cita_rechazada: {{1}} nombre, {{2}} día, {{3}} hora
CITA_CONFIRMADA_PLANTILLA=cita_confirmada
CITA_RECHAZADA_PLANTILLA=cita_rechazada

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plataforma Sofía PreFirma. En el proyecto piloto se fija la notaría; en subdominios
# *.sofiaprefirma.com también se resuelve por el dominio, nunca por datos del navegador.
NOTARIA_ID=notaria41

# Portal «Mis trámites»: genera una frase aleatoria de al menos 32 caracteres.
CUENTA_SECRETO=
# Correo transaccional. Verifica sofiaprefirma.com en Resend antes de habilitar el portal.
RESEND_API_KEY=
CORREO_REMITENTE=Sofía PreFirma <tramites@sofiaprefirma.com>

# Pagos de trámites. No hay pasarela real elegida todavía. El proveedor falso funciona
# solo en desarrollo/preview y exige un secreto; nunca se habilita en producción.
# PAGOS_PROVEEDOR=falso
# PAGOS_SECRETO_PRUEBA=

# Vercel Cron (cualquier texto largo y aleatorio)
CRON_SECRET=
